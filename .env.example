DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-chat"
LLM_FALLBACK_MODELS="deepseek-chat"
LLM_MAX_TOKENS=1200
LLM_RETRY_ATTEMPTS=1
LLM_FAILURE_COOLDOWN_SECONDS=300
VECTOR_DB_PATH="data/vector_db"
EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0
RETRIEVAL_DOMAIN_GUARD=1
CHROMA_COLLECTION_NAME="research_logs"
LOGS_DIR="data/logs"
EXTRA_MARKDOWN_FILES="实验进度记录.md"
PAPER_NOTES_DIR="data/paper_notes"
PAPERS_DIR="data/papers"
PAPER_TEXT_DIR="data/paper_text"
ENABLE_PDF_INGESTION=1
MEMORY_DB_PATH="data/memory/agent_memory.sqlite3"
GITHUB_TOKEN=""
ARXIV_MAX_RESULTS=5
GITHUB_MAX_RESULTS=5
REQUEST_TIMEOUT=8
CONTEXT_BUDGET_TOKENS=2800
